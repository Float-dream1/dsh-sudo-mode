  },
  "license": "MIT",
  "author": "Float-dream1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Float-dream1/dsh-sudo-mode.git"
  },
  "homepage": "https://github.com/Float-dream1/dsh-sudo-mode#readme",
  "bugs": {
    "url": "https://github.com/Float-dream1/dsh-sudo-mode/issues"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
